# Kết thúc dòng cố định trên mọi máy: runner Windows của GitHub Actions bật core.autocrlf=true,
# nên nếu không khai báo, corpus/golden test và chuỗi nhiều dòng trong test sẽ thành CRLF trên Windows.
* text=auto eol=lf
# Script Windows giữ CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

tools/package-readme.txt text eol=crlf
