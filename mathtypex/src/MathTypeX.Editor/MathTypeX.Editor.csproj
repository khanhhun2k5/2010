<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MathTypeX.Editor</AssemblyName>
    <RootNamespace>MathTypeX.Editor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Application.ThemeMode (Fluent, theo Light/Dark của hệ thống) vẫn là API thử nghiệm của WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Gói phát hành chỉ cần MathTypeX.Editor.exe: không kèm tài liệu XML của các gói NuGet (WebView2). -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MathTypeX.Editing\MathTypeX.Editing.csproj" />
    <ProjectReference Include="..\MathTypeX.Render.MathMl\MathTypeX.Render.MathMl.csproj" />
    <ProjectReference Include="..\MathTypeX.Fonts\MathTypeX.Fonts.csproj" />
  </ItemGroup>
</Project>
